  updatedAt DateTime @updatedAt

  @@index([status, placement, startsAt, endsAt])
  @@index([advertiserId])
}

enum AdType {
  SPONSORED_OFFER
  SPONSORED_BUSINESS
  FEATURED_PARTNER
}

enum AdPlacement {
  HOMEPAGE
  MARKETPLACE
}

enum AdStatus {
  DRAFT
  PENDING_PAYMENT
  PENDING_REVIEW
  APPROVED
  ACTIVE
  PAUSED
  REJECTED
  ENDED
}

// ============================================
// RATE ALERTS
// ============================================

model RateAlert {
  id               String         @id @default(auto()) @map("_id") @db.ObjectId
  userId           String         @db.ObjectId
  baseCurrency     String
  quoteCurrency    String
  targetRateScaled BigInt
  direction        AlertDirection
  isActive         Boolean        @default(true)
  cooldownMinutes  Int            @default(360)
  lastTriggeredAt  DateTime?
  triggerCount     Int            @default(0)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  @@index([userId, isActive])
  @@index([isActive, baseCurrency, quoteCurrency])
}

enum AlertDirection {
  ABOVE
  BELOW
}

// ============================================
// BUSINESS & API ACCESS
// ============================================

model BusinessProfile {
  id                 String    @id @default(auto()) @map("_id") @db.ObjectId
  ownerId            String    @unique @db.ObjectId
  legalName          String
  tradingName        String?
  country            String
  registrationNumber String?
  website            String?
  description        String?
  verified           Boolean   @default(false)
  verifiedAt         DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model BusinessMember {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  ownerId   String   @db.ObjectId
  memberId  String   @db.ObjectId
  role      String   @default("MEMBER")
  status    String   @default("ACTIVE")
  invitedAt DateTime @default(now())

  @@unique([ownerId, memberId])
  @@index([memberId])
}

model ApiKey {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  name      String
  keyPrefix String // shown in dashboards to identify the key
  keyHash   String   @unique // sha256 of the full key; the raw key is never stored
  scopes    String[] @default([])
  isActive  Boolean  @default(true)

  rateLimitPerMinute Int       @default(60)
  monthlyQuota       Int       @default(10000)
  requestCount       Int       @default(0)
  lastUsedAt         DateTime?

  rotatedFromId String?   @db.ObjectId
  createdAt     DateTime  @default(now())
  expiresAt     DateTime?
  revokedAt     DateTime?
  revokedBy     String?   @db.ObjectId

  @@index([userId, isActive])
}

model ApiUsageDaily {
  id       String @id @default(auto()) @map("_id") @db.ObjectId
  apiKeyId String @db.ObjectId
  day      String // YYYY-MM-DD (UTC)
  count    Int    @default(0)
  errors   Int    @default(0)

  @@unique([apiKeyId, day])
}

// ============================================
// VERIFICATION & KYC
// ============================================

model VerificationCase {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation("CaseOwner", fields: [userId], references: [id])

  type     VerificationCaseType
  tier     VerificationTier
  status   VerificationCaseStatus @default(SUBMITTED)
  provider String                 @default("MANUAL")

  documentType    String
  documentCountry String

  // Business verification
  businessName       String?
  registrationNumber String?

  // Paid enhanced verification is bound to a succeeded Payment.
  paymentId String? @db.ObjectId

  submittedAt     DateTime  @default(now())
  reviewStartedAt DateTime?
  reviewedAt      DateTime?
  reviewerId      String?   @db.ObjectId
  rejectionReason String?
  expiresAt       DateTime?
  // Documents are deleted from private storage after this date.
  retainUntil     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  documents VerificationDocument[]

  @@index([userId, status])
  @@index([status, submittedAt])
  @@index([expiresAt])
  @@index([retainUntil])
}

enum VerificationCaseType {
  INDIVIDUAL
  BUSINESS
}

enum VerificationCaseStatus {
  SUBMITTED
  UNDER_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

model VerificationDocument {
  id         String           @id @default(auto()) @map("_id") @db.ObjectId
  caseId     String           @db.ObjectId
  case       VerificationCase @relation(fields: [caseId], references: [id], onDelete: Cascade)
  kind       String // ID_FRONT | ID_BACK | SELFIE | BUSINESS_REGISTRATION | PROOF_OF_ADDRESS
  storageKey String // private (authenticated) object key
  mimeType   String
  sizeBytes  Int
  sha256     String
  uploadedAt DateTime         @default(now())
  deletedAt  DateTime?

  @@index([caseId])
}

// ============================================
// LIMITS
// ============================================

/// Configurable limits & feature flags. One row per policy key:
/// UNVERIFIED, VERIFIED, ENHANCED, PREMIUM, BUSINESS. Monetary limits are
/// expressed in `limitCurrency` minor units and compared via reference rates.
model LimitPolicy {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  key           String @unique
  name          String
  limitCurrency String @default("EUR")

  maxSwapMinor BigInt
  dailyMinor   BigInt
  weeklyMinor  BigInt
  monthlyMinor BigInt

  maxActiveOffers        Int
  maxActiveSwaps         Int
  maxRateAlerts          Int
  apiCallsPerMonth       Int
  maxBoostPurchasesMonth Int
  maxTeamMembers         Int @default(0)

  // Feature flags
  advancedSearch    Boolean @default(false)
  priorityMatching  Boolean @default(false)
  advancedAnalytics Boolean @default(false)
  premiumBadge      Boolean @default(false)
  prioritySupport   Boolean @default(false)
  apiAccess         Boolean @default(false)

  updatedBy String?  @db.ObjectId
  updatedAt DateTime @updatedAt
}

// ============================================
// RISK & ANTI-FRAUD
// ============================================

model RiskFlag {
  id         String         @id @default(auto()) @map("_id") @db.ObjectId
  userId     String?        @db.ObjectId
  swapId     String?        @db.ObjectId
  offerId    String?        @db.ObjectId
  referralId String?        @db.ObjectId
  type       RiskFlagType
  severity   RiskSeverity
  score      Int            @default(0)
  action     RiskAction     @default(ALLOW)
  status     RiskFlagStatus @default(OPEN)
  // Deterministic key so a detector can't spam duplicate open flags.
  dedupeKey  String         @unique
  details    Json?
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt

  reviews RiskReview[]

  @@index([userId, status])
  @@index([status, severity, createdAt])
  @@index([type])
}

enum RiskFlagType {
  LARGE_EXCHANGE
  RAPID_ACTIVITY
  REPEATED_CANCELLATIONS
  REPEATED_DISPUTES
  MULTIPLE_ACCOUNTS_DEVICE
  SUSPICIOUS_LOCATION_CHANGE
  REFERRAL_ABUSE
  ABNORMAL_FREQUENCY
  VERIFICATION_INCONSISTENCY
  PAYMENT_MISMATCH
}

enum RiskSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum RiskAction {
  ALLOW
  REQUIRE_VERIFICATION
  LIMIT_AMOUNT
  SUSPEND_OFFER
  SUSPEND_TRADING
  REQUIRE_REVIEW
}

enum RiskFlagStatus {
  OPEN
  REVIEWING
  DISMISSED
  ACTIONED
}

model RiskReview {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  flagId     String     @db.ObjectId
  flag       RiskFlag   @relation(fields: [flagId], references: [id], onDelete: Cascade)
  reviewerId String     @db.ObjectId
  decision   RiskAction
  note       String?
  createdAt  DateTime   @default(now())

  @@index([flagId])
}

// ============================================
// REFERRALS & PARTNERS (marketing payouts — not exchange custody)
// ============================================

model ReferralCode {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  userId    String   @unique @db.ObjectId
  code      String   @unique
  isPartner Boolean  @default(false)
  isActive  Boolean  @default(true)
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
}

/// Admin-configured qualification & commission rules.
model ReferralRule {
  id                     String             @id @default(auto()) @map("_id") @db.ObjectId
  code                   String             @unique
  name                   String
  // Meaningful qualifying action — never plain sign-up.
  qualifyingAction       QualifyingAction
  minCompletedSwaps      Int                @default(1)
  rewardType             ReferralRewardType @default(FIXED)
  rewardMinor            Int                @default(0)
  percentBps             Int                @default(0)
  currency               String             @default("EUR")
  isPartnerRule          Boolean            @default(false)
  monthlyCapPerReferrer  Int                @default(20)
  lifetimeCapPerReferrer Int                @default(500)
  holdDays               Int                @default(7) // reward is held for fraud review
  isActive               Boolean            @default(true)
  updatedAt              DateTime           @updatedAt
}

enum QualifyingAction {
  FIRST_COMPLETED_SWAP
  VERIFIED_AND_SWAP
  PAID_PLAN_PURCHASE
}

enum ReferralRewardType {
  FIXED
  PERCENT_OF_SERVICE_REVENUE
}

model Referral {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  referrerId String @db.ObjectId
  referrer   User   @relation("ReferralsMade", fields: [referrerId], references: [id])
  referredId String @unique @db.ObjectId
  referred   User   @relation("ReferralsReceived", fields: [referredId], references: [id])

  code   String
  status ReferralStatus @default(PENDING)

  qualifyingAction QualifyingAction?
  qualifiedAt      DateTime?

  signupDeviceHash String?
  signupIpHash     String?
  riskScore        Int      @default(0)
  fraudFlags       String[] @default([])

  rewardMinor     Int?
  rewardCurrency  String?
  rewardLedgerId  String?   @db.ObjectId
  rewardReleaseAt DateTime?
  rewardPaidAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([referrerId, status])
  @@index([status, rewardReleaseAt])
  @@index([code])
}

enum ReferralStatus {
  PENDING
  QUALIFIED
  UNDER_REVIEW
  REWARD_PENDING
  REWARDED
  REJECTED
  EXPIRED
}

// ============================================
