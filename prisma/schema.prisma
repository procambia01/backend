  clicks      Int               @default(0)
  createdAt   DateTime          @default(now())

  @@index([offerId, endsAt])
  @@index([placement, status, endsAt])
  @@index([userId, createdAt])
}

enum PromotionStatus {
  ACTIVE
  EXPIRED
  CANCELLED
}

/// Daily impression/click counters for Boost, Featured and Ads.
model PromotionDailyStat {
  id            String @id @default(auto()) @map("_id") @db.ObjectId
  promotionType String // BOOST | FEATURED | AD
  promotionId   String @db.ObjectId
  day           String // YYYY-MM-DD (UTC)
  impressions   Int    @default(0)
  clicks        Int    @default(0)

  @@unique([promotionType, promotionId, day])
}

model AdCampaign {
  id           String      @id @default(auto()) @map("_id") @db.ObjectId
  advertiserId String      @db.ObjectId
  type         AdType
  placement    AdPlacement
  title        String
  body         String?
  imageUrl     String?
  targetUrl    String?
  offerId      String?     @db.ObjectId

  // Targeting
  currencies String[] @default([])
  countries  String[] @default([])
  cities     String[] @default([])

  status      AdStatus  @default(DRAFT)
  startsAt    DateTime?
  endsAt      DateTime?
  paymentId   String?   @db.ObjectId
  productCode String?
  reviewedBy  String?   @db.ObjectId
  reviewNote  String?
  reviewedAt  DateTime?

  impressions Int @default(0)
  clicks      Int @default(0)

