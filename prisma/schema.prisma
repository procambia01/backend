model Boost {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  offerId     String          @db.ObjectId
  offer       SwapOffer       @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId      String          @db.ObjectId
  paymentId   String          @unique @db.ObjectId
  productCode String
  startsAt    DateTime
  endsAt      DateTime
  status      PromotionStatus @default(ACTIVE)
  priceMinor  Int
  currency    String
  impressions Int             @default(0)
  clicks      Int             @default(0)
  createdAt   DateTime        @default(now())

  @@index([offerId, endsAt])
  @@index([userId, createdAt])
  @@index([status, endsAt])
}

model FeaturedListing {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  offerId     String            @db.ObjectId
  offer       SwapOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  userId      String            @db.ObjectId
  paymentId   String            @unique @db.ObjectId
  productCode String
