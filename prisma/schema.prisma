// CashMouver — Prisma schema (MongoDB)
//
// Design rules (see docs/ARCHITECTURE.md):
//  * CashMouver NEVER custodies the currency users exchange. There is no
//    wallet, escrow, deposit, withdrawal or refund of exchanged cash anywhere
//    in this schema.
//  * The MongoDB connector has no Decimal type. All money is stored as
//    integers in minor units (BigInt for exchange amounts, Int for service
//    prices) and exchange rates are fixed-point BigInt scaled by 1e10
//    (see src/lib/money.ts). No Float is used for money or rates.
//  * `Payment` = money paid TO CashMouver for a service.
//    `Swap`/`SwapEvent` = marketplace activity between two users.
//    `LedgerEntry` = immutable record of CashMouver's own revenue.
//  * Optional fields are never marked @unique: MongoDB indexes a missing
//    field as null, so a second document without the field would collide.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows"]
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

// Geospatial point (GeoJSON). A 2dsphere index is created at startup by
// src/lib/geo-indexes.ts because Prisma cannot declare one.
type GeoPoint {
  type        String  @default("Point")
  coordinates Float[] // [longitude, latitude]
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  emailVerified Boolean  @default(false)
  name          String
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Credentials. tokenVersion is bumped on password change / "log out
  // everywhere" so every previously issued access token stops working.
  passwordHash      String?
  tokenVersion      Int       @default(0)
  passwordChangedAt DateTime?
  twoFactorEnabled  Boolean   @default(false)

  // Profile
  phone           String? // E.164
  phoneVerified   Boolean   @default(false)
  phoneVerifiedAt DateTime?
  bio             String?

  // Role & permissions
  role        UserRole @default(USER)
  permissions String[] @default([])

  // Verification (summary only — the source of truth is VerificationCase,
  // and these fields are written exclusively by VerificationService).
  verificationStatus    VerificationStatus @default(UNVERIFIED)
  verificationTier      VerificationTier   @default(NONE)
  idVerified            Boolean            @default(false)
  verifiedAt            DateTime?
  verificationExpiresAt DateTime?
  businessVerified      Boolean            @default(false)

  // Trust metrics (derived counters; not money)
  rating           Float @default(0)
  totalSwaps       Int   @default(0)
  successfulSwaps  Int   @default(0)
  cancelledSwaps   Int   @default(0)
  disputedSwaps    Int   @default(0)
  confirmationRate Float @default(0)
  responseRate     Float @default(0)
  trustScore       Int   @default(0)

  // Location. `privateLocation` is exact and NEVER leaves the server;
  // `areaCenter` is a coarse public trading area used for discovery.
  country            String?
  city               String?
  state              String?
  privateLocation    GeoPoint?
  areaCenter         GeoPoint?
  lastLocationUpdate DateTime?

  // Account status
  isActive          Boolean   @default(true)
  isBanned          Boolean   @default(false)
  banReason         String?
  bannedAt          DateTime?
  bannedBy          String?   @db.ObjectId
  banExpiry         DateTime?
  isSuspended       Boolean   @default(false)
  suspensionReason  String?
  suspendedAt       DateTime?
  suspendedBy       String?   @db.ObjectId
  suspensionExpiry  DateTime?
  tradingRestricted Boolean   @default(false) // set by risk actions
  deletedAt         DateTime?

  // Plan entitlements (denormalised from Subscription, written only by the
  // verified Stripe webhook). Entitlement checks also compare planExpiresAt
  // with "now", so an expired plan is rejected even if no job has run.
  planTier      PlanTier  @default(FREE)
  planExpiresAt DateTime?

  // Preferences / i18n
  preferredCurrencies     String[] @default([])
  preferredMeetingPlaces  String[] @default([])
  notificationPreferences Json?
  languagePreference      String   @default("en")
  timezone                String   @default("UTC")
  darkMode                Boolean  @default(false)
  receiveEmails           Boolean  @default(true)
  receiveSMS              Boolean  @default(true)
  receivePush             Boolean  @default(true)

  // Relations
  sessions          AuthSession[]
  offersCreated     SwapOffer[]        @relation("OfferCreator")
  swapsAsInitiator  Swap[]             @relation("SwapInitiator")
  swapsAsReceiver   Swap[]             @relation("SwapReceiver")
  messages          Message[]
  ratingsGiven      Rating[]           @relation("RatingGiver")
  ratingsReceived   Rating[]           @relation("RatingReceiver")
  disputesReported  Dispute[]          @relation("DisputeReporter")
  disputesAgainst   Dispute[]          @relation("DisputeAgainst")
  disputesResolved  Dispute[]          @relation("DisputeResolver")
  notifications     Notification[]
  payments          Payment[]
  subscriptions     Subscription[]
  savedLocations    SavedLocation[]
  blockedUsers      BlockedUser[]      @relation("BlockedBy")
  blockedBy         BlockedUser[]      @relation("Blocking")
  favorites         FavoriteUser[]     @relation("Favorites")
  favoritedBy       FavoriteUser[]     @relation("FavoritedBy")
  pushTokens        PushToken[]
  activities        ActivityLog[]
  apiKeys           ApiKey[]
  verificationCases VerificationCase[] @relation("CaseOwner")
  referralsMade     Referral[]         @relation("ReferralsMade")
  referralReceived  Referral[]         @relation("ReferralsReceived")

  @@index([role])
  @@index([planTier, planExpiresAt])
  @@index([verificationStatus])
  @@index([createdAt])
}

enum UserRole {
  USER
  STAFF
  ADMIN
  SUPER_ADMIN
}

enum PlanTier {
  FREE
  PREMIUM
  BUSINESS
}

enum VerificationStatus {
  UNVERIFIED
  PENDING
  VERIFIED
  REJECTED
  EXPIRED
}

enum VerificationTier {
  NONE
  BASIC
  ENHANCED
}

/// Refresh-token backed login session (rotation + reuse detection).
model AuthSession {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // All rotated tokens of one login share a familyId. Presenting an
  // already-rotated refresh token revokes the whole family.
  familyId         String
  refreshTokenHash String    @unique
  deviceId         String?
  deviceName       String?
  ipAddress        String?
  userAgent        String?
  reauthUntil      DateTime?

  createdAt     DateTime  @default(now())
  lastUsedAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  revokedReason String?
  rotatedAt     DateTime?

  @@index([userId, revokedAt])
  @@index([familyId])
  @@index([expiresAt])
}

/// Devices seen for an account — drives new-device login alerts and the
/// multi-account / referral-abuse risk checks. Only salted hashes are kept.
model LoginDevice {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  userId     String   @db.ObjectId
  deviceHash String
  label      String?
  firstSeen  DateTime @default(now())
  lastSeen   DateTime @default(now())

  @@unique([userId, deviceHash])
  @@index([deviceHash])
}

/// Single-use email / password-reset tokens (stored hashed).
model EmailToken {
  id        String    @id @default(auto()) @map("_id") @db.ObjectId
  userId    String    @db.ObjectId
  purpose   String // EMAIL_VERIFY | PASSWORD_RESET
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, purpose])
  @@index([expiresAt])
}

/// Phone verification one-time passcodes (hashed, expiring, attempt-limited).
model OtpChallenge {
  id                String     @id @default(auto()) @map("_id") @db.ObjectId
  userId            String     @db.ObjectId
  purpose           OtpPurpose
  phone             String
  codeHash          String
  attempts          Int        @default(0)
  maxAttempts       Int        @default(5)
  resendAvailableAt DateTime
  expiresAt         DateTime
  consumedAt        DateTime?
  createdAt         DateTime   @default(now())

  @@index([userId, purpose, createdAt])
  @@index([expiresAt])
}

enum OtpPurpose {
  PHONE_VERIFY
}

/// One verified phone number belongs to exactly one account.
model VerifiedPhone {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  phone      String   @unique
  userId     String   @unique @db.ObjectId
  verifiedAt DateTime @default(now())
}

model TwoFactorSecret {
  id               String    @id @default(auto()) @map("_id") @db.ObjectId
  userId           String    @unique @db.ObjectId
  secretEnc        String // AES-256-GCM encrypted base32 secret
  backupCodeHashes String[]  @default([])
  confirmedAt      DateTime?
  createdAt        DateTime  @default(now())
}

// ============================================
// CURRENCIES
// ============================================

model Currency {
  id        String  @id @default(auto()) @map("_id") @db.ObjectId
  code      String  @unique // ISO 4217
  name      String
  symbol    String
  minorUnit Int     @default(2)
  region    String // EUROPE | NORTH_AMERICA | SOUTH_AMERICA | ASIA | OCEANIA | AFRICA | MIDDLE_EAST
  isActive  Boolean @default(true)
  isPopular Boolean @default(false)
  sortOrder Int     @default(1000)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, sortOrder])
  @@index([region])
}

/// Fixed-point (1e10) reference rates. `rateScaled` = units of `quote` per
/// 1 unit of `base`.
model ExchangeRateSnapshot {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  baseCurrency  String
  quoteCurrency String
  rateScaled    BigInt
  source        String   @default("ECB")
  createdAt     DateTime @default(now())

  @@index([baseCurrency, quoteCurrency, createdAt])
}

// ============================================
// OFFERS (marketplace inventory)
// ============================================

model SwapOffer {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation("OfferCreator", fields: [userId], references: [id], onDelete: Cascade)

  // Currencies — "have" is what the owner will hand over, "want" what they
  // want to receive. Amounts are minor units of the respective currency.
  haveCurrency   String
  wantCurrency   String
  haveTotalMinor BigInt // original amount offered
  rateScaled     BigInt // want per 1 have, scaled 1e10
  minSwapMinor   BigInt @default(0) // smallest slice a taker may reserve (have currency)

  // Inventory reservation (NOT custody — just stops one offer being sold
  // twice). Invariant: remaining + reserved + consumed == haveTotalMinor.
  remainingMinor BigInt
  reservedMinor  BigInt @default(0)
  consumedMinor  BigInt @default(0)

  // Location. `privateLocation` is exact and never serialised; `area` is the
  // coarse public trading area (snapped + deterministically jittered).
  country         String
  city            String
  state           String?
  area            GeoPoint
  areaLabel       String?
  privateLocation GeoPoint?
  radiusKm        Int       @default(5)
  meetingArea     String?

  // Availability
  availableFrom  DateTime
  availableUntil DateTime
  timeSlots      String[] @default([])
  isFlexible     Boolean  @default(true)

  // Status
  status     OfferStatus     @default(ACTIVE)
  visibility OfferVisibility @default(PUBLIC)

  // Additional info
  notes                  String?
  preferredMeetingPlaces String[] @default([])
  requiresVerifiedUsers  Boolean  @default(false)
  minTrustScore          Int      @default(0)

  // Metrics
  viewCount  Int @default(0)
  matchCount Int @default(0)

  // Paid placement (denormalised from Boost / FeaturedListing so ranking
  // queries are cheap; authority is always the dated record).
  boostedUntil  DateTime?
  featuredUntil DateTime?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiresAt DateTime?

  swaps        Swap[]
  reservations OfferReservation[]
  boosts       Boost[]
  featured     FeaturedListing[]

  @@index([userId])
  @@index([status, expiresAt])
  @@index([status, haveCurrency, wantCurrency])
  @@index([country, city])
  @@index([availableUntil])
  @@index([boostedUntil])
  @@index([featuredUntil])
  @@index([createdAt])
}

enum OfferStatus {
  ACTIVE
  PAUSED
  COMPLETED
  CANCELLED
  EXPIRED
}

enum OfferVisibility {
  PUBLIC
  VERIFIED_ONLY
  PREMIUM_ONLY
  PRIVATE
}

/// Slice of an offer held for one swap. Created atomically with the swap.
model OfferReservation {
  id          String            @id @default(auto()) @map("_id") @db.ObjectId
  offerId     String            @db.ObjectId
  offer       SwapOffer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  swapId      String            @unique @db.ObjectId
  amountMinor BigInt
  status      ReservationStatus @default(HELD)
  expiresAt   DateTime
  releasedAt  DateTime?
  consumedAt  DateTime?
  createdAt   DateTime          @default(now())

  @@index([offerId, status])
  @@index([status, expiresAt])
}

enum ReservationStatus {
  HELD
  RELEASED
  CONSUMED
  EXPIRED
}

// ============================================
// SWAPS (user ⇄ user — no CashMouver custody)
// ============================================

model Swap {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  initiatorId String    @db.ObjectId
  initiator   User      @relation("SwapInitiator", fields: [initiatorId], references: [id])
  receiverId  String    @db.ObjectId // the offer owner
  receiver    User      @relation("SwapReceiver", fields: [receiverId], references: [id])
  offerId     String    @db.ObjectId
  offer       SwapOffer @relation(fields: [offerId], references: [id])

  // Terms as requested (computed server-side from the offer; never trusted
  // from the client). "have" = offer owner's currency.
  haveCurrency        String
  wantCurrency        String
  requestedHaveMinor  BigInt
  requestedWantMinor  BigInt
  requestedRateScaled BigInt

  // Immutable snapshot taken when the receiver accepts (PENDING → AGREED).
  agreedHaveMinor  BigInt?
  agreedWantMinor  BigInt?
  agreedRateScaled BigInt?
  agreedAt         DateTime?

  status SwapStatus @default(PENDING)

  // Completion confirmations — each party confirms they handed over their
  // cash and received the other's.
  initiatorConfirmed   Boolean   @default(false)
  initiatorConfirmedAt DateTime?
  receiverConfirmed    Boolean   @default(false)
  receiverConfirmedAt  DateTime?

  startedAt          DateTime?
  completedAt        DateTime?
  cancelledAt        DateTime?
  cancelledBy        String?         @db.ObjectId
  cancelCode         SwapCancelCode?
  cancellationReason String?

  expiresAt      DateTime // pending-acceptance expiry
  remindersSent  Int       @default(0)
  lastReminderAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  events   SwapEvent[]
  meetups  Meetup[]
  messages Message[]
  ratings  Rating[]
  disputes Dispute[]

  @@index([initiatorId, status])
  @@index([receiverId, status])
  @@index([offerId])
  @@index([status, updatedAt])
  @@index([status, expiresAt])
  @@index([createdAt])
}

enum SwapStatus {
  PENDING
  AGREED
  IN_PROGRESS
  CONFIRMING
  COMPLETED
  CANCELLED
  DISPUTED
}

enum SwapCancelCode {
  REJECTED
  USER_CANCELLED
  EXPIRED
  OFFER_UNAVAILABLE
  DISPUTE_RESOLUTION
  ADMIN
}

/// Append-only audit trail of every swap state change / side effect. The
/// unique `dedupeKey` makes side effects idempotent (e.g. `COMPLETED:<swapId>`).
model SwapEvent {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  swapId         String        @db.ObjectId
  swap           Swap          @relation(fields: [swapId], references: [id], onDelete: Cascade)
  actorId        String?       @db.ObjectId
  eventType      SwapEventType
  previousStatus SwapStatus?
  newStatus      SwapStatus?
  metadata       Json?
  dedupeKey      String        @unique
  createdAt      DateTime      @default(now())

  @@index([swapId, createdAt])
  @@index([eventType])
}

enum SwapEventType {
  CREATED
  ACCEPTED
  REJECTED
  MEETUP_PROPOSED
  MEETUP_ACCEPTED
  MEETUP_CANCELLED
  STARTED
  PARTY_CONFIRMED
  COMPLETED
  CANCELLED
  EXPIRED
  DISPUTED
  DISPUTE_RESOLVED
  RESERVATION_HELD
  RESERVATION_RELEASED
  RESERVATION_CONSUMED
  SIDE_EFFECTS_APPLIED
  REMINDER_SENT
  EXTENSION_REQUESTED
}

// ============================================
// MEETUPS
// ============================================

model Meetup {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  swapId String @db.ObjectId
  swap   Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)

  proposedById String  @db.ObjectId
  parentId     String? @db.ObjectId // meetup this one counter-proposes / reschedules

  locationName       String
  approximateAddress String // safe to show to both parties before acceptance
  // Exact venue details are only returned to the two swap participants once
  // the meetup is ACCEPTED.
  exactAddress       String?
  privateNotes       String?
  location           GeoPoint?

  scheduledAt DateTime
  status      MeetupStatus @default(PROPOSED)

  initiatorConfirmed Boolean @default(false)
  receiverConfirmed  Boolean @default(false)

  initiatorCheckedInAt  DateTime?
  receiverCheckedInAt   DateTime?
  initiatorCheckedOutAt DateTime?
  receiverCheckedOutAt  DateTime?

  cancelledById String?   @db.ObjectId
  cancelledAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([swapId, status])
  @@index([scheduledAt])
}

enum MeetupStatus {
  PROPOSED
  COUNTER_PROPOSED
  ACCEPTED
  RESCHEDULED
  SUPERSEDED
  CANCELLED
  COMPLETED
}

// ============================================
// MESSAGING
// ============================================

model Message {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  swapId String @db.ObjectId
  swap   Swap   @relation(fields: [swapId], references: [id], onDelete: Cascade)

  senderId String @db.ObjectId
  sender   User   @relation(fields: [senderId], references: [id])

  content     String
  messageType MessageType @default(TEXT)
  attachments String[]    @default([])

  readAt    DateTime?
  isEdited  Boolean   @default(false)
  editedAt  DateTime?
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())

  @@index([swapId, createdAt])
  @@index([swapId, readAt])
  @@index([senderId])
}

enum MessageType {
  TEXT
  IMAGE
  SYSTEM
}

model MessageReport {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  messageId  String   @db.ObjectId
  reporterId String   @db.ObjectId
  reason     String
  status     String   @default("OPEN")
  createdAt  DateTime @default(now())

  @@unique([messageId, reporterId])
  @@index([status])
}

// ============================================
// RATINGS
// ============================================

model Rating {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  swapId String @db.ObjectId
  swap   Swap   @relation(fields: [swapId], references: [id])

  giverId    String @db.ObjectId
  giver      User   @relation("RatingGiver", fields: [giverId], references: [id])
  receiverId String @db.ObjectId
  receiver   User   @relation("RatingReceiver", fields: [receiverId], references: [id])

  stars   Int
  comment String?

  punctuality     Int?
  communication   Int?
  professionalism Int?
  safety          Int?

  isReported   Boolean @default(false)
  reportReason String?
  isHidden     Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([swapId, giverId])
  @@index([receiverId, createdAt])
}

// ============================================
// DISPUTES
// ============================================

model Dispute {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  swapId String @db.ObjectId
  swap   Swap   @relation(fields: [swapId], references: [id])

  reporterId String @db.ObjectId
  reporter   User   @relation("DisputeReporter", fields: [reporterId], references: [id])
  againstId  String @db.ObjectId
  against    User   @relation("DisputeAgainst", fields: [againstId], references: [id])

  reason      DisputeReason
  description String

  status      DisputeStatus   @default(OPEN)
  priority    DisputePriority @default(MEDIUM)
  isEscalated Boolean         @default(false)
  assignedTo  String?         @db.ObjectId

  // CashMouver never refunds or moves exchanged currency. Outcomes only
  // affect the swap record, reputation and account standing.
  outcome        DisputeOutcome?
  resolutionNote String?
  resolvedById   String?         @db.ObjectId
  resolvedBy     User?           @relation("DisputeResolver", fields: [resolvedById], references: [id])
  resolvedAt     DateTime?
  closedAt       DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  evidence DisputeEvidence[]
  events   DisputeEvent[]

  @@index([swapId])
  @@index([reporterId])
  @@index([status, priority])
  @@index([createdAt])
}

enum DisputeReason {
  NO_SHOW
  WRONG_AMOUNT
  FAKE_CURRENCY
  UNSAFE_BEHAVIOR
  HARASSMENT
  FRAUD
  COUNTERFEIT_MONEY
  THREATENING_BEHAVIOR
  OTHER
}

enum DisputeStatus {
  OPEN
  INVESTIGATING
  RESOLVED
  CLOSED
}

enum DisputePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum DisputeOutcome {
  SWAP_COMPLETED
  SWAP_CANCELLED
  WARNING
  ACCOUNT_RESTRICTION
  ESCALATED
  NO_ACTION
}

model DisputeEvidence {
  id         String       @id @default(auto()) @map("_id") @db.ObjectId
  disputeId  String       @db.ObjectId
  dispute    Dispute      @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  uploaderId String       @db.ObjectId
  type       EvidenceType
  storageKey String // private object key — served only via short-lived signed URLs
  mimeType   String
  sizeBytes  Int
  sha256     String
  metadata   Json?
  createdAt  DateTime     @default(now())

  @@index([disputeId])
}

enum EvidenceType {
  PHOTO
  SCREENSHOT
  DOCUMENT
  CHAT_EXPORT
  OTHER
}

model DisputeEvent {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  disputeId String   @db.ObjectId
  dispute   Dispute  @relation(fields: [disputeId], references: [id], onDelete: Cascade)
  actorId   String?  @db.ObjectId
  type      String
  note      String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([disputeId, createdAt])
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type    NotificationType
  title   String
  message String

  // Navigation target — resolved identically by web and mobile from
  // `route` + `entityId` (see contracts NotificationRoute).
  route    NotificationRoute
  entityId String?
  data     Json?
  /// Idempotency key for event-driven notifications (not unique: Mongo treats missing fields as equal).
  dedupeKey String?

  isRead  Boolean   @default(false)
  readAt  DateTime?
  isPush  Boolean   @default(true)
  isEmail Boolean   @default(false)
  isSMS   Boolean   @default(false)

  createdAt DateTime @default(now())

  @@index([userId, isRead, createdAt])
  @@index([userId, dedupeKey])
  @@index([createdAt])
}

enum NotificationType {
  MATCH_FOUND
  SWAP_REQUEST
  SWAP_ACCEPTED
  SWAP_REJECTED
  SWAP_STARTED
  SWAP_CONFIRMED
  SWAP_COMPLETED
  SWAP_CANCELLED
  MEETUP_PROPOSED
  MEETUP_ACCEPTED
  MESSAGE_RECEIVED
  RATING_RECEIVED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  VERIFICATION_UPDATE
  OFFER_BOOSTED
  OFFER_FEATURED
  OFFER_EXPIRING
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  PLAN_EXPIRING
  PLAN_EXPIRED
  RATE_ALERT
  REFERRAL_UPDATE
  ACCOUNT_WARNING
  LOGIN_ALERT
  SYSTEM_ALERT
}

enum NotificationRoute {
  SWAP_DETAILS
  MEETUP
  CHAT
  DISPUTE
  OFFER
  SERVICE_PAYMENT
  RATE_ALERT
  VERIFICATION
  PLAN
  REFERRALS
  PROFILE
  NOTIFICATIONS
}

model NotificationTemplate {
  id            String           @id @default(auto()) @map("_id") @db.ObjectId
  type          NotificationType
  locale        String           @default("en")
  titleTemplate String
  bodyTemplate  String
  isActive      Boolean          @default(true)
  updatedBy     String?          @db.ObjectId
  updatedAt     DateTime         @updatedAt

  @@unique([type, locale])
}

model PushToken {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  token    String  @unique
  platform String
  deviceId String?
  isActive Boolean @default(true)

  createdAt  DateTime @default(now())
  lastUsedAt DateTime @default(now())

  @@index([userId])
}

// ============================================
// SERVICE PRODUCTS, PAYMENTS & LEDGER (money paid TO CashMouver)
// ============================================

/// Admin-configurable catalogue. Prices are NEVER taken from a client.
model ServiceProduct {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  code          String             @unique // e.g. PREMIUM_MONTHLY, BOOST_24H
  kind          ProductKind
  name          String
  description   String?
  amountMinor   Int
  currency      String // ISO 4217 (lower/upper normalised in code)
  interval      BillingInterval    @default(ONE_TIME)
  durationHours Int? // Boost / Featured / Ad duration
  planTier      PlanTier? // for PREMIUM_PLAN / BUSINESS_PLAN
  placement     FeaturedPlacement? // for FEATURED
  trialDays     Int                @default(0)
  features      String[]           @default([])
  config        Json? // e.g. { rateLimitPerMinute, monthlyQuota } for API plans
  isActive      Boolean            @default(true)
  sortOrder     Int                @default(100)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@index([kind, isActive, sortOrder])
}

enum ProductKind {
  PREMIUM_PLAN
  BUSINESS_PLAN
  API_PLAN
  BOOST
  FEATURED
  VERIFICATION
  ADVERTISING
}

enum BillingInterval {
  ONE_TIME
  MONTH
  YEAR
}

enum FeaturedPlacement {
  HOMEPAGE
  MARKETPLACE_TOP
  CURRENCY_PAIR
}

model BillingCustomer {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  userId           String   @unique @db.ObjectId
  stripeCustomerId String   @unique
  createdAt        DateTime @default(now())
}

/// A payment made to CashMouver for a CashMouver service. Never exchange funds.
model Payment {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id])

  productId   String        @db.ObjectId
  productCode String
  kind        ProductKind
  amountMinor Int
  currency    String // upper-case ISO code
  status      PaymentStatus @default(REQUIRES_PAYMENT)

  // What the purchase applies to (offer id, ad campaign id, …).
  targetType String?
  targetId   String?

  // Deterministic key per business operation → duplicate fulfilment is impossible.
  idempotencyKey String @unique

  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  stripeInvoiceId         String?
  stripeSubscriptionId    String?

  fulfilledAt   DateTime?
  paidAt        DateTime?
  failedAt      DateTime?
  failureReason String?
  refundedMinor Int       @default(0)
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt])
  @@index([status, createdAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
  @@index([stripeInvoiceId])
  @@index([stripeSubscriptionId])
  @@index([kind, status])
}

enum PaymentStatus {
  REQUIRES_PAYMENT
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
  EXPIRED
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Immutable record of CashMouver's own revenue / costs. Corrections are new
/// compensating entries (`reversesId`), never edits. Not a user wallet.
model LedgerEntry {
  id          String          @id @default(auto()) @map("_id") @db.ObjectId
  entryType   LedgerEntryType
  direction   LedgerDirection
  amountMinor Int // always positive; direction gives the sign
  currency    String
  paymentId   String?         @db.ObjectId
  userId      String?         @db.ObjectId
  reversesId  String?         @db.ObjectId
  reference   String          @unique // idempotency, e.g. payment:<id>:sale
  description String?
  createdBy   String?         @db.ObjectId
  createdAt   DateTime        @default(now())

  @@index([entryType, createdAt])
  @@index([paymentId])
  @@index([userId, createdAt])
  @@index([createdAt])
}

enum LedgerEntryType {
  PREMIUM_SUBSCRIPTION
  BUSINESS_SUBSCRIPTION
  API_SUBSCRIPTION
  BOOST_PURCHASE
  FEATURED_PURCHASE
  VERIFICATION_FEE
  AD_PURCHASE
  REFUND
  REFERRAL_REWARD
  ADJUSTMENT
}

enum LedgerDirection {
  CREDIT
  DEBIT
}

model StripeWebhookEvent {
  id            String             @id @default(auto()) @map("_id") @db.ObjectId
  stripeEventId String             @unique
  eventType     String
  livemode      Boolean            @default(false)
  objectId      String?
  payload       Json? // minimal reference, never card data
  status        WebhookEventStatus @default(RECEIVED)
  attempts      Int                @default(0)
  error         String?
  receivedAt    DateTime           @default(now())
  processedAt   DateTime?

  @@index([status, receivedAt])
  @@index([eventType])
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSING
  PROCESSED
  FAILED
  IGNORED
}

model Subscription {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  stripeSubscriptionId String      @unique
  stripeCustomerId     String
  productCode          String
  kind                 ProductKind
  tier                 PlanTier

  status             SubscriptionStatus @default(INCOMPLETE)
  interval           BillingInterval
  amountMinor        Int
  currency           String
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean            @default(false)
  canceledAt         DateTime?
  trialEnd           DateTime?
  latestInvoiceId    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, status])
  @@index([status, currentPeriodEnd])
}

enum SubscriptionStatus {
  INCOMPLETE
  TRIALING
  ACTIVE
  PAST_DUE
  UNPAID
  CANCELLED
}

