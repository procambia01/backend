{
  "name": "backend",
  "version": "1.0.0",
  "description": "Backend API for Currency Exchange Platform",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon",
    "build": "tsc && tsc-alias",
    "start": "node dist/server.js",
    "start:prod": "pm2 start ecosystem.config.js --env production",
