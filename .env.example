# ============================================
# SwapFX Backend — Environment Variables
# Copy to .env for local dev. For Cloud Run, set these as environment
# variables / secrets in the service configuration instead of a file —
# see the deployment guide for exactly where in the console.
# ============================================

# ── Application ─────────────────────────────
NODE_ENV=development
# Cloud Run sets PORT automatically at runtime — you do not need to set
# this yourself in the Cloud Run console, only for local dev.
PORT=5000
APP_NAME=SwapFX
# Local dev: http://localhost:3001 (web). Production: your Cloudflare
# Pages domain, e.g. https://swapfx.pages.dev or your custom domain.
APP_URL=http://localhost:3001
# Local dev: http://localhost:5000/api/v1. Production: your Cloud Run
# service URL + /api/v1.
API_URL=http://localhost:5000/api/v1

# ── Database (MongoDB) ──────────────────────
# A MongoDB Atlas connection string. Cloud Run has no built-in MongoDB
# service — Atlas's free/shared tier is the standard pairing.
DATABASE_URL=mongodb+srv://user:password@cluster.mongodb.net/swapfx

# ── Auth secrets — generate with: openssl rand -base64 32 ──
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_TRUST_HOST=false
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=30d
SESSION_SECRET=
COOKIE_SECRET=

# ── Redis ────────────────────────────────────
# Recommended for Cloud Run: a serverless provider like Upstash
# (rediss:// URL, no VPC connector needed). REDIS_URL takes priority
# over the individual HOST/PORT/PASSWORD fields below when set.
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── CORS ─────────────────────────────────────
# Comma-separated, no trailing slashes. Must include your Cloudflare
# Pages domain(s) in production, e.g.:
# https://swapfx.pages.dev,https://swapfx.com
CORS_ORIGIN=http://localhost:3001
ALLOWED_ORIGINS=http://localhost:3001

# ── Cloudinary (image/document uploads) ─────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=swapfx

# ── Email ────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@swapfx.com
EMAIL_FROM_NAME=SwapFX
RESEND_API_KEY=

# ── SMS (Twilio) ─────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Push notifications ───────────────────────
EXPO_ACCESS_TOKEN=

# ── Payments ─────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_ENCRYPTION_KEY=

# ── Exchange rates & maps ────────────────────
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=
GOOGLE_MAPS_API_KEY=

# ── Rate limiting ────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ── File upload ──────────────────────────────
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/jpg,application/pdf

# ── Security ─────────────────────────────────
BCRYPT_ROUNDS=10

# ── Verification & trust ─────────────────────
VERIFICATION_FEE_AMOUNT=5.00
MIN_TRUST_SCORE=0
MAX_SWAP_AMOUNT_UNVERIFIED=100
MAX_SWAP_AMOUNT_VERIFIED=10000

# ── Premium pricing ──────────────────────────
PREMIUM_MONTHLY_PRICE=9.99
PREMIUM_YEARLY_PRICE=99.99
BUSINESS_MONTHLY_PRICE=29.99
BUSINESS_YEARLY_PRICE=299.99

# ── Admin (seeds the first super-admin account) ──
SUPER_ADMIN_EMAIL=admin@swapfx.com
SUPER_ADMIN_PASSWORD=

# ── Logging ──────────────────────────────────
LOG_LEVEL=info
LOG_FILE_PATH=./logs

# ── Socket.IO ────────────────────────────────
SOCKET_PORT=5001

# ── Cron jobs ────────────────────────────────
ENABLE_CRON_JOBS=true
EXCHANGE_RATE_UPDATE_CRON=0 */6 * * *
CLEANUP_CRON=0 2 * * *

# ── Development-only toggles ─────────────────
DEBUG=false
MOCK_PAYMENTS=false
MOCK_SMS=false
MOCK_EMAIL=false
