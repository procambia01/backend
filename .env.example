# ============================================
# CashMouver API – environment variables
# Copy to .env for local development. In production set these as
# secrets / environment variables on your platform. Never commit .env.
# ============================================

NODE_ENV=development
PORT=8080
APP_NAME=CashMouver
APP_URL=http://localhost:3000
API_URL=http://localhost:8080/api/v1
TRUST_PROXY=1

# ── Database (MongoDB; Prisma needs a replica set for transactions, e.g. Atlas) ──
DATABASE_URL=mongodb+srv://user:password@cluster.example.mongodb.net/cashmouver

# ── Secrets: generate each with  openssl rand -base64 48  (all ≥ 32 chars) ──
JWT_SECRET=
JWT_REFRESH_SECRET=
COOKIE_SECRET=
HASH_PEPPER=
DATA_ENCRYPTION_KEY=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_ROUNDS=12

# ── Redis (optional; rate limiting degrades gracefully without it) ──
REDIS_URL=
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── CORS (comma-separated, no trailing slash) ──
CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,https://cashmouver.com,https://www.cashmouver.com

# ── Cloudinary (public avatars + PRIVATE storage for KYC and dispute evidence) ──
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=cashmouver

# ── Email ──
EMAIL_DRIVER=console        # smtp | resend | console (console is refused in production)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=no-reply@cashmouver.com
EMAIL_FROM_NAME=CashMouver
RESEND_API_KEY=

# ── SMS OTP (Twilio) ──
SMS_DRIVER=console          # twilio | console (console is refused in production)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ── Push ──
EXPO_ACCESS_TOKEN=

# ── Stripe: the only payment processor. Used for CashMouver service fees ONLY. ──
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=      # endpoint: POST {API_URL}/webhooks/stripe

# ── Reference exchange rates (default provider needs no key) ──
EXCHANGE_RATE_API_KEY=
EXCHANGE_RATE_API_URL=
GOOGLE_MAPS_API_KEY=

# ── Rate limiting / uploads ──
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=300
MAX_FILE_SIZE=8388608

# ── KYC retention ──
KYC_DOCUMENT_RETENTION_DAYS=90
VERIFICATION_VALID_MONTHS=24
SIGNED_URL_TTL_SECONDS=120

# ── First super-admin (used by `npm run prisma:seed`; password ≥ 12 chars) ──
SUPER_ADMIN_EMAIL=admin@cashmouver.com
SUPER_ADMIN_PASSWORD=

# ── Logging / background jobs ──
LOG_LEVEL=info
LOG_FILE_PATH=./logs
LOG_TO_FILE=false
ENABLE_CRON_JOBS=true
